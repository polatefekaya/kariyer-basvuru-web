# Backend API origin — legacy media paths (`images/<uuid>-x.jpg`) resolve against this.
VITE_API_URL=https://tst.kariyerzamani.com/api
# file-service public CDN (Cloudflare R2 + Image Transformations). `public/...` keys resolve here.
# 'true' runs the ATS screens against the local recruiting service while the rest stays mocked.
VITE_RECRUITING_LIVE=false
VITE_RECRUITING_API_URL=http://localhost:5340/api/recruiting
VITE_CDN_URL=https://cdn-test.kariyerzamani.com
# kariyer-file-service (presigned upload / download).
VITE_FILE_SERVICE_URL=https://tst.kariyerzamani.com
# Supabase (auth session → Bearer token for the API). Same project as kariyer-zamani-web:
# copy REACT_APP_SUPABASE_URL / REACT_APP_SUPABASE_ANON_KEY from that app's .env (the anon key is public by design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_HUB_URL=https://auth.kariyerzamani.com/login
# Mock APIs (in-memory data, no backend). Default: on in dev while VITE_SUPABASE_URL is empty.
# VITE_USE_MOCKS=true
